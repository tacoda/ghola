# Credentials. Providers read these from the engine's environment; nothing is
# written into config/, which is tracked.
.env

# Runtime state, owned by the factory.
state/
runs/

# The engine's own scratch. `iii.lock` is NOT here: it pins the harness version,
# and a ladder mounted on harness 1.8.1 looks wired and enforces nothing.
.iii/

# Python
.venv/
__pycache__/
*.egg-info/
*.py[cod]

.DS_Store
audit/

# Worker logs. Useful locally, noise in a diff.
.logs/

# The screenshot tool's dependencies and its scratch output. The script itself
# is tracked: docs pictures go stale, and the way to retake them should not.
.tooling/node_modules/
.tooling/package-lock.json
.tooling/capture.log
.tooling/JOBID
.tooling/explore.mjs

# This machine's repositories. `repos.toml` is the tracked template.
repos.local.toml

# This machine's own agent settings. `.agents/settings.json` is tracked and
# holds what the repository asks of everybody; the `.local` one is yours. Both
# are in the ladder's `SETTINGS_FILES`, so either is honored if it is there.
.agents/settings.local.json
